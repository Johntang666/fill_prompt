{
  "manifest_version": 3,
  "name": "快捷提示词",
  "version": "1.1.0",
  "description": "保存常用提示词，一键填入 ChatGPT、Gemini 和 Claude。支持搜索、编辑、排序与导入导出。",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*"
      ],
      "js": ["assets/content.js"]
    }
  ]
}
